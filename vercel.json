{
  "rewrites": [
    {
      "source": "/auth/:path*",
      "destination": "https://tinderaibackend.onrender.com/auth/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://tinderaibackend.onrender.com/:path*"
    },
    {
      "source": "/terms",
      "destination": "/terms.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    }
  ]
}
